{
  "name": "orderwise-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "description": "Backend API for OrderWise - AI-assisted priority-based order allocation platform",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write \"src/**/*.{js,json}\" \"tests/**/*.{js,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,json}\" \"tests/**/*.{js,json}\"",
    "build": "echo Backend does not require separate build step",
    "migrate": "node-pg-migrate --migrations-dir src/db/migrations",
    "seed": "node src/db/seeds/demo.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-pg-migrate": "^7.5.2",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "embedded-postgres": "^15.18.0-beta.17",
    "eslint": "^9.8.0",
    "fast-check": "^4.10.2",
    "globals": "^15.9.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "vitest": "^2.0.5"
  }
}
